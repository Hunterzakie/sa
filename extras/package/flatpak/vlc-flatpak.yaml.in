id: org.flatpak.Vlc
runtime: org.kde.Platform
runtime-version: '6.8'
sdk: org.kde.Sdk
command: vlc
sdk-extensions:
  - org.freedesktop.Sdk.Extension.openjdk17

modules:
  - name: vlc
    buildsystem: simple
    build-options:
      build-args:
        - "--share=network"
        - "--filesystem=${VLC_SRC}"
      env:
        PATH: /app/bin:/usr/bin:/usr/lib/sdk/openjdk17/bin
        JAVA_HOME: /usr/lib/sdk/openjdk17/jvm/openjdk-17
    build-commands:
      - sh ${VLC_SRC}/extras/package/flatpak/flatpak-process.sh
    sources:
      - type: file
        path: timestamp

finish-args:
  - --share=network
  - --socket=x11
  - --socket=wayland
  - --device=dri
  - --filesystem=home
