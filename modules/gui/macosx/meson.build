macosx_plugin_flags = []
macosx_plugin_deps = [
    avfoundation_dep,
    avkit_dep,
    cocoa_dep,
    coreaudio_dep,
    coregraphics_dep,
    corevideo_dep,
    iokit_dep,
    mediaplayer_dep,
    quartz_dep,
    quicklook_dep,
    quicklookthumbnailing_dep,
    scriptingbridge_dep,
    webkit_dep,
]

metal_dep = dependency('appleframeworks',
    modules: [ 'Metal', 'MetalKit' ],
    required: get_option('macosx_ui_shaders'))
if get_option('macosx_ui_shaders').allowed()
    macosx_plugin_deps += metal_dep
    # todo: SUFFXIES += .air .metal
endif

