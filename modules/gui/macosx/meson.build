    'UI/About.xib',
    'UI/AddonManager.xib',
    'UI/AudioEffects.xib',
    'UI/Bookmarks.xib',
    'UI/ConvertAndSave.xib',
    'UI/CoreDialogs.xib',
    'UI/ErrorPanel.xib',
    'UI/Help.xib',
    'UI/LogMessageWindow.xib',
    'UI/MainMenu.xib',
    'UI/VLCCustomCropARPanel.xib',
    'UI/VLCDetachedAudioWindow.xib',
    'UI/VLCLibraryAlbumTableCellView.xib',
    'UI/VLCLibraryWindow.xib',
    'UI/VLCLibraryWindowChaptersView.xib',
    'UI/VLCLibraryWindowNavigationSidebarView.xib',
    'UI/VLCLibraryWindowPlayQueueView.xib',
    'UI/VLCLibraryWindowSidebarRootView.xib',
    'UI/VLCLibraryWindowTitlesView.xib',
    'UI/VLCLibraryTableCellView.xib',
    'UI/VLCLibraryVideoTableCellView.xib',
    'UI/VLCPlayQueueTableCellView.xib',
    'UI/VLCLibraryCarouselViewItemView.xib',
    'UI/VLCLibraryCollectionViewMediaItemListSupplementaryDetailView.xib',
    'UI/VLCLibraryCollectionViewAudioGroupSupplementaryDetailView.xib',
    'UI/VLCLibraryCollectionViewMediaItemSupplementaryDetailView.xib',
    'UI/VLCLibraryHeroView.xib',
    'UI/VLCLibraryHomeViewActionsView.xib',
    'UI/VLCLibrarySongTableCellView.xib',
    'UI/VLCClassicMainVideoView.xib',
    'UI/VLCMainVideoView.xib',
    'UI/VLCMainVideoViewAudioMediaDecorativeView.xib',
    'UI/VLCMediaItemCollectionViewItem.xib',
    'UI/VLCMediaSourceDeviceCollectionViewItem.xib',
    'UI/VLCInformationWindow.xib',
    'UI/VLCPlaybackEndView.xib',
    'UI/Open.xib',
    'UI/PlaylistAccessoryView.xib',
    'UI/PopupPanel.xib',
    'UI/Preferences.xib',
    'UI/ResumeDialog.xib',
    'UI/SimplePreferences.xib',
    'UI/StreamOutput.xib',
    'UI/SyncTracks.xib',
    'UI/TextfieldPanel.xib',
    'UI/TimeSelectionPanel.xib',
    'UI/VideoEffects.xib',
    'UI/VLCFullScreenPanel.xib',
    'UI/VLCStatusBarIconMainMenu.xib',
)

ibtool = generator(
    find_program('ibtool', required: true),
    output : '@BASENAME@.nib',
    arguments : [
        '--errors',
        '--warnings',
        '--notices',
        ['--module', 'VLC'],
        '--auto-activate-custom-fonts',
        ['--target-device', 'mac'],
        ['--minimum-deployment-target', '10.13'],
        ['--output-format', 'human-readable-text'],
        ['--compile', '@OUTPUT@'],
        '@INPUT@',
    ],
)

xib_targets = []
foreach xib : macosx_plugin_xib_sources
    xib_targets += ibtool.process(xib)
endforeach

vlc_modules += {
    'name' : 'macosx',
    'sources' : macosx_plugin_sources,
    'extra_files' : macosx_plugin_xib_sources,
    'dependencies' : macosx_plugin_deps,
    'objc_args' : ['-fobjc-arc', '-fobjc-exceptions'],
    'include_directories' : include_directories('.'),
}
